---
import '../styles/global.css';
import { getSiteSettings, type SiteSettings } from '../lib/sanity';

interface Props {
	title?: string;
	description?: string;
	siteSettings?: SiteSettings;
}

const {
	title = 'Kim Flower Shop — Flowers for the everyday',
	description = 'Thoughtful flowers and arrangements for the moments that matter.',
siteSettings: providedSettings,
} = Astro.props;

const settings = providedSettings ?? await getSiteSettings();
const primaryColor = /^#[\da-f]{6}$/i.test(settings.primaryColor ?? '')
	? settings.primaryColor!
	: '#8D4F59';
const announcement = settings.showAnnouncement && settings.announcementText?.trim()
	? settings.announcementText.trim()
	: '';
---

<!doctype html>
<html lang="en" style={`--theme-primary: ${primaryColor}`}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content={primaryColor} />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		{announcement && <div class="announcement-bar">{announcement}</div>}

		<header class="site-header">
			<div class="header-inner">
				<a class="brand" href="/" aria-label="Kim Flower Shop home">
					<span class="brand-mark" aria-hidden="true">
						<svg viewBox="0 0 40 40" fill="none">
							<path d="M20 5.5c3.2 4.1 4.4 7 3.5 9.1 2.3-1.1 5.6-.2 10 2.5-4.4 2.6-7.7 3.4-10 2.3 1 2.2-.2 5.3-3.5 9.5-3.1-4.2-4.2-7.3-3.2-9.5-2.4 1.1-5.7.3-10-2.3 4.3-2.7 7.6-3.6 10-2.5-1-2.1.1-5 3.2-9.1Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
							<circle cx="20" cy="18.5" r="2.2" fill="currentColor" />
							<path d="M20 29v6m0-3c-2.2-2.2-4.4-2.3-6.4-.5M20 32c2.2-2.2 4.4-2.3 6.4-.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
						</svg>
					</span>
					<span class="brand-copy">
						<strong>Kim Flower Shop</strong>
						<small>Flowers for the everyday</small>
					</span>
				</a>

				<nav class="main-nav" aria-label="Main navigation">
					<a href="/#collection">Shop flowers</a>
					<a href="/#story">Our approach</a>
				</nav>

				<a class="header-link" href="/#collection">
					Explore the shop <span aria-hidden="true">↗</span>
				</a>
			</div>
		</header>

		<slot />

		<footer class="site-footer">
			<div class="footer-inner">
				<a class="footer-brand" href="/">Kim Flower Shop</a>
				<p>Thoughtful flowers, made for life's little moments.</p>
				<div class="social-links" aria-label="Social media">
					<a
						class="social-link"
						href="https://www.facebook.com/izekeeem"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Visit Kim Flower Shop on Facebook (opens in a new tab)"
					>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M13.5 21v-8h2.7l.4-3.1h-3.1V8c0-.9.3-1.5 1.6-1.5h1.6V3.7c-.3 0-1.4-.1-2.7-.1-2.7 0-4.5 1.6-4.5 4.6v1.7h-3v3.1h3v8h4Z" fill="currentColor" />
						</svg>
					</a>
					<a
						class="social-link"
						href="https://www.instagram.com/artbyisbll/"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Visit Kim Flower Shop on Instagram (opens in a new tab)"
					>
						<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8" />
							<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" />
							<circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
						</svg>
					</a>
				</div>
				<span>© {new Date().getFullYear()} Kim Flower Shop</span>
			</div>
		</footer>
	</body>
</html>

<style>
	.announcement-bar {
		padding: 0.7rem 1.25rem;
		background: var(--theme-primary);
		color: white;
		text-align: center;
		font-size: 0.78rem;
		letter-spacing: 0.025em;
	}

	.site-header {
		position: relative;
		z-index: 2;
		background: var(--page);
	}

	.header-inner {
		width: min(100% - 3rem, 1180px);
		min-height: 88px;
		margin-inline: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		border-bottom: 1px solid var(--line);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--ink);
		text-decoration: none;
	}

	.brand-mark {
		width: 2.75rem;
		height: 2.75rem;
		display: grid;
		place-items: center;
		border: 1px solid color-mix(in srgb, var(--theme-primary), transparent 68%);
		border-radius: 50%;
		color: var(--theme-primary);
	}

	.brand-mark svg {
		width: 1.9rem;
		height: 1.9rem;
	}

	.brand-copy {
		display: grid;
		gap: 0.1rem;
	}

	.brand-copy strong,
	.footer-brand {
		font-family: var(--serif);
		font-size: 1.16rem;
		font-weight: 500;
		letter-spacing: -0.035em;
	}

	.brand-copy small {
		color: var(--muted);
		font-size: 0.63rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.main-nav {
		display: flex;
		align-items: center;
		gap: clamp(1.5rem, 3vw, 2.8rem);
	}

	.main-nav a,
	.header-link {
		color: var(--ink);
		font-size: 0.82rem;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.main-nav a:hover,
	.header-link:hover {
		color: var(--theme-primary);
	}

	.header-link {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.8rem 1rem;
		border: 1px solid var(--line);
		border-radius: 999px;
	}

	.header-link span {
		color: var(--theme-primary);
		font-size: 1rem;
	}

	.site-footer {
		padding: 2rem 0;
		border-top: 1px solid var(--line);
	}

	.footer-inner {
		width: min(100% - 3rem, 1180px);
		margin-inline: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		color: var(--muted);
		font-size: 0.76rem;
	}

	.footer-brand {
		color: var(--ink);
		text-decoration: none;
	}

	.footer-inner p {
		margin: 0;
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.55rem;
	}

	.social-link {
		width: 2.25rem;
		height: 2.25rem;
		display: grid;
		place-items: center;
		border: 1px solid var(--line);
		border-radius: 50%;
		color: var(--muted);
		transition: border-color 160ms ease, color 160ms ease, background 160ms ease;
	}

	.social-link:hover {
		border-color: var(--theme-primary);
		background: color-mix(in srgb, var(--theme-primary), white 94%);
		color: var(--theme-primary);
	}

	.social-link svg {
		width: 1.05rem;
		height: 1.05rem;
	}

	@media (max-width: 720px) {
		.header-inner {
			width: min(100% - 2rem, 1180px);
			min-height: 76px;
			gap: 1rem;
		}

		.brand-mark {
			width: 2.45rem;
			height: 2.45rem;
		}

		.brand-copy strong {
			font-size: 1.02rem;
		}

		.brand-copy small,
		.main-nav {
			display: none;
		}

		.header-link {
			padding: 0.68rem 0.8rem;
			font-size: 0.75rem;
		}

		.footer-inner {
			width: min(100% - 2rem, 1180px);
			flex-wrap: wrap;
		}

		.footer-inner p {
			order: 3;
			width: 100%;
		}
	}
</style>

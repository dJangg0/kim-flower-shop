---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getActiveProducts, getSanityImageUrl, getSiteSettings, type Product } from '../lib/sanity';

const siteSettingsPromise = getSiteSettings();
let products: Product[] = [];
let productsUnavailable = false;

try {
	products = await getActiveProducts();
} catch (error) {
	productsUnavailable = true;
	console.error('Could not load active products from Sanity:', error);
}

const siteSettings = await siteSettingsPromise;
const saleProducts = products.filter((product) =>
	product.isOnSale === true
	&& typeof product.price === 'number'
	&& typeof product.salePrice === 'number'
	&& product.salePrice >= 0
	&& product.salePrice < product.price,
);
const featuredProduct = products.find((product) => product.image?.asset?.url);
const featuredImage = featuredProduct?.image?.asset?.url
	? getSanityImageUrl(featuredProduct.image.asset.url, 1200)
	: undefined;
---

<Layout
	title="Kim Flower Shop — Thoughtful flowers for every day"
	description="Discover thoughtful flowers and arrangements for the moments that matter."
	siteSettings={siteSettings}
>
	<main>
		<section class="hero" aria-labelledby="hero-title">
			<div class="hero-inner">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> A little beauty, gathered daily</p>
					<h1 id="hero-title">Make room<br />for <em>flowers.</em></h1>
					<p class="hero-description">
						Thoughtful blooms for life's everyday moments, heartfelt gestures, and everything worth celebrating.
					</p>
					<div class="hero-actions">
						<a class="button-primary" href="#collection">Explore the flowers <span aria-hidden="true">↓</span></a>
						<a class="text-link" href="#story">A little about us <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-note">
						<span class="note-flower" aria-hidden="true">✳</span>
						<span>Flowers chosen with care,<br />arranged to feel like you.</span>
					</div>
				</div>

				<div class="hero-visual">
					{featuredImage ? (
						<img
							class="hero-image"
							src={featuredImage}
							alt={featuredProduct?.name ?? 'Flowers from Kim Flower Shop'}
							width={featuredProduct?.image?.asset?.metadata?.dimensions?.width}
							height={featuredProduct?.image?.asset?.metadata?.dimensions?.height}
							fetchpriority="high"
							decoding="async"
						/>
					) : (
						<div class="hero-placeholder" aria-hidden="true">
							<span class="placeholder-stem stem-one"></span>
							<span class="placeholder-stem stem-two"></span>
							<span class="placeholder-bloom bloom-one">✿</span>
							<span class="placeholder-bloom bloom-two">✿</span>
							<span class="placeholder-bloom bloom-three">✿</span>
							<span class="placeholder-note">A fresh arrangement<br />is on its way</span>
						</div>
					)}
					<div class="visual-caption">
						<span class="caption-sparkle" aria-hidden="true">✳</span>
						<span>Flowers for a softer kind of everyday</span>
					</div>
				</div>
			</div>
		</section>

		{saleProducts.length > 0 && (
			<section id="on-sale" class="sale-collection" aria-labelledby="sale-title">
				<div class="section-wrap">
					<div class="section-heading">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> Special picks</p>
							<h2 id="sale-title">A little something <em>on sale.</em></h2>
						</div>
						<p class="collection-intro">Thoughtful blooms, now at a special price.</p>
					</div>
					<div class="product-grid">
						{saleProducts.map((product) => <ProductCard product={product} currency={siteSettings.currency} />)}
					</div>
				</div>
			</section>
		)}

		<section id="collection" class="collection section-wrap" aria-labelledby="collection-title">
			<div class="section-heading">
				<div>
					<p class="eyebrow"><span aria-hidden="true"></span> The flower shop</p>
					<h2 id="collection-title">A fresh pick for <em>your day.</em></h2>
				</div>
				<p class="collection-intro">Small gestures, big feelings, and a little colour for wherever you call home.</p>
			</div>

			{products.length > 0 ? (
				<div class="product-grid">
					{products.map((product) => <ProductCard product={product} currency={siteSettings.currency} />)}
				</div>
			) : (
				<div class="empty-state">
					<span class="empty-flower" aria-hidden="true">✿</span>
					<h3>{productsUnavailable ? 'The flower shelf is taking a moment' : 'A fresh bunch is on its way'}</h3>
					<p>
						{productsUnavailable
							? 'We could not load the collection just now. Please refresh in a little while.'
							: 'There are no active arrangements to show just yet. Please check back soon.'}
					</p>
				</div>
			)}
		</section>

		<section id="story" class="story-section">
			<div class="story-inner">
				<div class="story-mark" aria-hidden="true">
					<svg viewBox="0 0 120 120" fill="none">
						<path d="M60 12c8.4 10.8 11.4 18.5 9.2 24.1 6.1-3 14.7-.5 26.3 6.6-11.4 6.8-20.1 8.9-26.2 6.1 2.4 5.8-.5 13.9-9.2 25-8.2-11.1-11.1-19.2-8.5-25-6.4 2.8-15.1.7-26.4-6.1 11.4-7.1 20.1-9.6 26.3-6.6C45.1 30.5 48.1 22.8 60 12Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
						<circle cx="60" cy="47" r="6" fill="currentColor" />
						<path d="M60 74v34m0-17c-11-11-21.5-11.5-31-2.5M60 91c11-11 21.5-11.5 31-2.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
					</svg>
				</div>
				<div class="story-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> A little about us</p>
					<h2>Good flowers.<br /><em>Good feelings.</em></h2>
					<p>
						We believe flowers can make an ordinary day feel a little more special. Find something to give, to share, or simply to bring home for yourself.
					</p>
					<a class="text-link" href="#collection">Find your flowers <span aria-hidden="true">↗</span></a>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		background:
			radial-gradient(ellipse at 92% 4%, rgb(232 217 202 / 42%), transparent 34rem),
			var(--page);
	}

	.hero-inner,
	.section-wrap,
	.story-inner {
		width: min(100% - 3rem, 1180px);
		margin-inline: auto;
	}

	.hero-inner {
		min-height: min(720px, calc(100svh - 88px));
		padding-block: clamp(4rem, 7vw, 6rem);
		display: grid;
		grid-template-columns: minmax(0, 0.93fr) minmax(350px, 0.78fr);
		align-items: center;
		gap: clamp(3rem, 8vw, 8.5rem);
	}

	.hero-copy {
		max-width: 550px;
		padding-block: 1rem 2rem;
	}

	.eyebrow {
		margin: 0 0 1.25rem;
		display: flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--theme-primary);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.eyebrow span {
		width: 1.5rem;
		height: 1px;
		background: currentColor;
	}

	.hero h1,
	.section-heading h2,
	.story-copy h2 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 400;
		letter-spacing: -0.065em;
	}

	.hero h1 {
		max-width: 9ch;
		font-size: clamp(4.4rem, 8vw, 7.25rem);
		line-height: 0.91;
	}

	.hero h1 em,
	.section-heading h2 em,
	.story-copy h2 em {
		color: var(--theme-primary);
		font-weight: 400;
	}

	.hero-description {
		max-width: 39ch;
		margin: 1.8rem 0 0;
		color: var(--muted);
		font-size: 1rem;
		line-height: 1.8;
	}

	.hero-actions {
		margin-top: 2rem;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1.35rem;
	}

	.button-primary {
		min-height: 3.25rem;
		padding: 0.85rem 1.15rem;
		display: inline-flex;
		align-items: center;
		gap: 1.35rem;
		background: var(--theme-primary);
		color: white;
		font-size: 0.8rem;
		text-decoration: none;
		transition: transform 160ms ease, filter 160ms ease;
	}

	.button-primary:hover {
		filter: brightness(0.92);
		transform: translateY(-2px);
	}

	.button-primary span {
		font-size: 1.1rem;
	}

	.text-link {
		color: var(--ink);
		font-size: 0.8rem;
		text-decoration: none;
	}

	.text-link span {
		padding-left: 0.3rem;
		color: var(--theme-primary);
	}

	.text-link:hover {
		color: var(--theme-primary);
	}

	.hero-note {
		margin-top: clamp(3rem, 6vw, 5rem);
		display: flex;
		align-items: center;
		gap: 0.8rem;
		color: var(--muted);
		font-size: 0.72rem;
		line-height: 1.55;
	}

	.note-flower {
		width: 2.25rem;
		height: 2.25rem;
		display: grid;
		place-items: center;
		border: 1px solid var(--line);
		border-radius: 50%;
		color: var(--theme-primary);
		font-size: 1.15rem;
	}

	.hero-visual {
		position: relative;
		justify-self: end;
		width: min(100%, 470px);
		aspect-ratio: 0.8;
		background: #ecdfd4;
	}

	.hero-image {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
	}

	.visual-caption {
		position: absolute;
		left: -2.5rem;
		bottom: 2.2rem;
		max-width: 205px;
		padding: 1rem 1.1rem;
		display: flex;
		align-items: center;
		gap: 0.7rem;
		background: var(--page);
		box-shadow: 0 12px 35px rgb(44 39 33 / 8%);
		color: var(--ink);
		font-family: var(--serif);
		font-size: 0.98rem;
		line-height: 1.25;
	}

	.caption-sparkle {
		color: var(--theme-primary);
		font-family: var(--sans);
		font-size: 1.1rem;
	}

	.hero-placeholder {
		position: absolute;
		inset: 0;
		overflow: hidden;
		background:
			radial-gradient(ellipse at 48% 100%, #bdc9b2 0 15%, transparent 15.5%),
			linear-gradient(145deg, #efe3d8, #d9c7b8);
	}

	.placeholder-stem {
		position: absolute;
		bottom: 15%;
		left: 50%;
		width: 2px;
		background: #6f886e;
		transform-origin: bottom;
	}

	.stem-one {
		height: 50%;
		transform: rotate(-10deg);
	}

	.stem-two {
		height: 42%;
		transform: rotate(12deg);
	}

	.placeholder-bloom {
		position: absolute;
		color: var(--theme-primary);
		font-size: clamp(4rem, 10vw, 7rem);
		line-height: 1;
		text-shadow: 0 2px 0 rgb(255 255 255 / 35%);
	}

	.bloom-one {
		top: 18%;
		left: 19%;
	}

	.bloom-two {
		top: 6%;
		left: 44%;
		color: #d39e74;
		font-size: clamp(5rem, 12vw, 8rem);
	}

	.bloom-three {
		top: 27%;
		right: 13%;
		color: #b77073;
	}

	.placeholder-note {
		position: absolute;
		right: 1rem;
		bottom: 1rem;
		color: #6d695f;
		font-size: 0.68rem;
		line-height: 1.45;
		text-align: right;
	}

	.collection {
		padding-block: clamp(5.5rem, 10vw, 8rem);
	}

	.sale-collection {
		padding-block: clamp(4.25rem, 7vw, 6.25rem);
		background: #f4ede6;
	}

	.section-heading {
		margin-bottom: 2.6rem;
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
	}

	.section-heading h2 {
		font-size: clamp(2.7rem, 5.2vw, 4.5rem);
		line-height: 1.02;
	}

	.collection-intro {
		max-width: 31ch;
		margin: 0 0 0.35rem;
		color: var(--muted);
		font-size: 0.83rem;
		line-height: 1.7;
	}

	.product-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.2rem;
	}

	.empty-state {
		min-height: 260px;
		padding: 2rem;
		display: grid;
		align-content: center;
		justify-items: center;
		background: #f1ece4;
		text-align: center;
	}

	.empty-flower {
		color: var(--theme-primary);
		font-size: 2rem;
	}

	.empty-state h3 {
		margin: 0.75rem 0 0;
		font-family: var(--serif);
		font-size: 1.65rem;
		font-weight: 400;
	}

	.empty-state p {
		max-width: 42ch;
		margin: 0.55rem 0 0;
		color: var(--muted);
		font-size: 0.82rem;
		line-height: 1.65;
	}

	.story-section {
		padding-block: clamp(4rem, 8vw, 6rem);
		background: #f0eae1;
	}

	.story-inner {
		min-height: 360px;
		display: grid;
		grid-template-columns: 0.85fr 1fr;
		align-items: center;
		gap: clamp(3rem, 10vw, 9rem);
	}

	.story-mark {
		width: min(100%, 350px);
		aspect-ratio: 1;
		margin-inline: auto;
		display: grid;
		place-items: center;
		border: 1px solid color-mix(in srgb, var(--theme-primary), transparent 72%);
		border-radius: 50%;
		color: var(--theme-primary);
	}

	.story-mark svg {
		width: 58%;
		height: 58%;
	}

	.story-copy {
		max-width: 480px;
	}

	.story-copy h2 {
		font-size: clamp(3.3rem, 6vw, 5rem);
		line-height: 0.99;
	}

	.story-copy > p:not(.eyebrow) {
		max-width: 43ch;
		margin: 1.3rem 0 1.5rem;
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.8;
	}

	@media (max-width: 900px) {
		.hero-inner {
			grid-template-columns: minmax(0, 1fr) minmax(280px, 0.8fr);
			gap: 3rem;
		}

		.hero h1 {
			font-size: clamp(4rem, 9vw, 6rem);
		}

		.product-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			row-gap: 2.5rem;
		}
	}

	@media (max-width: 650px) {
		.hero-inner,
		.section-wrap,
		.story-inner {
			width: min(100% - 2rem, 1180px);
		}

		.hero-inner {
			min-height: auto;
			padding-block: 3.75rem 4.5rem;
			grid-template-columns: 1fr;
			gap: 2.6rem;
		}

		.hero-copy {
			padding: 0;
		}

		.hero h1 {
			font-size: clamp(4.15rem, 17vw, 6rem);
		}

		.hero-description {
			margin-top: 1.25rem;
			font-size: 0.92rem;
		}

		.hero-note {
			margin-top: 2rem;
		}

		.hero-visual {
			width: calc(100% - 1.5rem);
			justify-self: center;
		}

		.visual-caption {
			left: -1.25rem;
			bottom: 1rem;
			max-width: 180px;
			padding: 0.8rem;
			font-size: 0.85rem;
		}

		.collection {
			padding-block: 4.5rem;
		}

		.section-heading {
			margin-bottom: 1.8rem;
			align-items: start;
			flex-direction: column;
			gap: 0.9rem;
		}

		.section-heading h2 {
			font-size: clamp(2.6rem, 11vw, 3.6rem);
		}

		.product-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.product-image-wrap {
			aspect-ratio: 0.94;
		}

		.story-section {
			padding-block: 3.5rem;
		}

		.story-inner {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.story-mark {
			width: min(62vw, 250px);
		}

		.story-copy h2 {
			font-size: clamp(3.2rem, 13vw, 4.5rem);
		}
	}
</style>
